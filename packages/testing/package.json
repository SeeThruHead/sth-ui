{
  "name": "@sth-ui/testing",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../lint/oxlintrc.json src tools",
    "test": "bun --bun vitest run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "capacity:concurrency": "bun tools/concurrency.ts",
    "capacity:summary": "bun tools/summary.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "effect": "4.1.2",
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/bun": "1.4.3",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
