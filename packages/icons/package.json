{
  "name": "@sth-ui/icons",
  "private": true,
  "description": "Phosphor's icons as Foldkit views.",
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "effect-tsgo --tsrs-lint oxlint --type-aware --deny-warnings -c ../lint/oxlintrc.json src tools",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun --bun vitest run",
    "generate": "bun tools/generate.ts && oxfmt src"
  },
  "dependencies": {
    "foldkit": "0.170.0"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.1.2",
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "4.1.2",
    "@phosphor-icons/core": "2.1.1",
    "@sth-ui/lint": "workspace:*",
    "@sth-ui/testing": "workspace:*",
    "@types/bun": "1.4.3",
    "@vitest/coverage-istanbul": "5.0.5",
    "effect": "4.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
