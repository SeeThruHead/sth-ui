{
  "name": "@sth-ui/tiptap",
  "private": true,
  "description": "Mantine's tiptap package, ported to Foldkit and Effect: a rich text editor built on Tiptap with a toolbar of controls.",
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings -c ../lint/oxlintrc.json src .storybook",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun run test:logic && bun run test:components",
    "test:logic": "bun --bun vitest run",
    "test:components": "bun --bun vitest run --config vitest.components.config.ts",
    "storybook": "storybook dev --port 6127 --no-open",
    "storybook:build": "storybook build --output-dir dist/storybook"
  },
  "dependencies": {
    "@foldkit/ui": "0.170.0",
    "@sth-ui/core": "workspace:*",
    "@sth-ui/icons": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "@tiptap/core": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "effect": "4.1.2",
    "foldkit": "0.170.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.64.1",
    "@effect/vitest": "4.1.2",
    "@sth-ui/lint": "workspace:*",
    "@sth-ui/testing": "workspace:*",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/html-vite": "10.6.2",
    "@stylexjs/unplugin": "0.19.1",
    "@tiptap/extension-code-block-lowlight": "3.33.0",
    "@tiptap/extension-details": "3.33.0",
    "@tiptap/extension-highlight": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-invisible-characters": "3.33.0",
    "@tiptap/extension-subscript": "3.33.0",
    "@tiptap/extension-superscript": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-text-align": "3.33.0",
    "@tiptap/extension-text-style": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@types/bun": "1.4.3",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "lowlight": "3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "storybook": "10.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
