{
  "name": "@sth-ui/form",
  "private": true,
  "description": "Mantine's form package, ported to Foldkit and Effect: form and field state as submodels, Effect Schema validation and Mantine's validators.",
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "effect-tsgo --tsrs-lint oxlint --type-aware --deny-warnings -c ../lint/oxlintrc.json src .storybook",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun run test:logic && bun run test:components",
    "test:logic": "bun --bun vitest run",
    "test:components": "bun --bun vitest run --config vitest.components.config.ts",
    "storybook": "storybook dev --port 6125 --no-open",
    "storybook:build": "storybook build --output-dir dist/storybook"
  },
  "dependencies": {
    "@sth-ui/core": "workspace:*",
    "effect": "4.1.2",
    "foldkit": "0.170.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "4.1.2",
    "@foldkit/ui": "0.170.0",
    "@sth-ui/lint": "workspace:*",
    "@sth-ui/testing": "workspace:*",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/html-vite": "10.6.2",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/bun": "1.4.3",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "storybook": "10.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
