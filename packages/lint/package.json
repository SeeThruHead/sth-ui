    "@babel/types": "8.0.6",
    "@effect/platform-bun": "4.1.2",
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "4.1.2",
    "@sth-ui/testing": "workspace:*",
    "@types/bun": "1.4.3",
    "@vitest/coverage-istanbul": "5.0.5",
    "effect": "4.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
