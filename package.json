{
  "name": "sth-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "bun run setup",
    "setup": "lefthook install",
    "moon": "moon",
    "check": "moon run :check",
    "check:affected": "moon run :check --affected",
    "devtools-mcp": "foldkit-devtools-mcp",
    "ci": "dagger call check --source ."
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@foldkit/devtools-mcp": "0.26.0",
    "@moonrepo/cli": "2.6.4",
    "lefthook": "2.2.2",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@babel/types": "8.0.6",
    "@effect/platform-browser": "4.1.2",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node-shared": "4.1.2",
    "@effect/vitest": "4.1.2",
    "effect": "4.1.2"
  },
  "patchedDependencies": {
    "foldkit@0.170.0": "patches/foldkit@0.170.0.patch"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 Firefox versions"
  ]
}
