{
  "name": "@sth-ui/docs",
  "private": true,
  "scripts": {
    "typecheck": "bun run props && bun run examples && tsc -p tsconfig.json && tsc -p tsconfig.site.json",
    "lint": "oxlint -c ../../packages/lint/oxlintrc.json tools",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "props": "bun tools/props.ts",
    "pages": "bun tools/pages.ts",
    "storybook": "sh scripts/storybook.sh",
    "start": "sh scripts/start.sh",
    "build": "bun run storybook && bun run props && bun run examples && bun run pages && docusaurus build",
    "serve": "docusaurus serve --port 3220 --no-open",
    "examples": "bun tools/examples.ts",
    "mantine-styles-api": "bun tools/mantine-styles-api.ts",
    "mantine-props": "bun tools/mantine-props.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource-variable/outfit": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@effect/platform-bun": "4.1.2",
    "@effect/tsgo": "0.64.1",
    "@sth-ui/core": "workspace:*",
    "@sth-ui/lint": "workspace:*",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "effect": "4.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
