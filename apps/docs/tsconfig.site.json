{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["@docusaurus/module-type-aliases"],
    "paths": { "@site/*": ["./*"] }
  },
  "include": ["src", "docusaurus.config.ts", "sidebars.ts"]
}
